# Backend configuration only. This package does not load .env files automatically.
DAYTONA_API_KEY=
# An OCI image accessible to stable Daytona, with sh and your required runtime.
DAYTONA_IMAGE=
# An existing absolute directory in that image, writable by the selected user.
DAYTONA_WORKDIR=
# Optional: existing guest username. Omit to use the target image/platform default.
# DAYTONA_USER=
# Opt in only after reviewing sandbox-wide public preview access:
# DAYTONA_PUBLIC_PREVIEW=1
# Opt in only after accepting whole-minute TTL rounding:
# DAYTONA_TIMEOUT_ROUNDING=ceil

# Optional: credentials for the two-provider migration test, never committed values.
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
